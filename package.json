{
  "name": "@nest-me-up/auth-modules",
  "version": "0.0.2",
  "description": "Library for NestJs authorization components for Web or Micro Services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [],
  "author": "ItaiH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nest-me-up/auth-modules.git"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev src/index.ts",
    "test": "service_config='src/config/test.yml' jest --passWithNoTests --detectOpenHandles --forceExit",
    "test:ci": "service_config='src/config/ci.yml' jest --passWithNoTests --forceExit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:component": "service_config='src/utils/config/test.yml' jest --config test/component/config/jest-component-test.json --runInBand --forceExit --detectOpenHandles",
    "test:component-ci": "service_config='src/utils/config/ci.yml' jest --config test/component/config/jest-component-test.json --runInBand --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.971.0",
    "amazon-cognito-identity-js": "^6.3.16",
    "class-validator": "^0.14.3",
    "jwks-rsa": "^3.2.1"
  },
  "peerDependencies": {
    "@nest-me-up/common": ">=1.0.0",
    "@nestjs/passport": ">=10.0.0",
    "passport-jwt": ">=4.0.0",
    "uuid": ">=9.0.0 <12.0.0"
  },
  "devDependencies": {
    "@nest-me-up/common": "^1.0.14",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/passport": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "nestjs-pino": "^4.5.0",
    "passport-jwt": "^4.0.1",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "uuid": "^11.1.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
